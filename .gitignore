# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.next/
out/
.turbo/
*.tsbuildinfo
infra/**/*.js
infra/**/*.d.ts
!infra/jest.config.js

# CDK
cdk.out/
cdk.context.json
.cdk.staging/

# Python
__pycache__/
*.egg-info/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local object storage for the filesystem driver and Playwright output
.polycast-data/
apps/web/test-results/
apps/web/playwright-report/
apps/web/e2e/.tmp/

# Local environment / credentials: never commit these
.env
.env.*
!.env.example
*.pem

# Local media and fixtures larger than a few hundred KB do not belong in git
*.mp4
*.mov
*.wav
*.mp3
!services/media-worker/tests/fixtures/*.wav

# Editors / OS
.vscode/
.idea/
.DS_Store
*.log

# Local Claude Code settings (shared settings.json is committed; local overrides are not)
.claude/settings.local.json

# Claude Code agent worktrees
.claude/worktrees/
