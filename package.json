{
  "name": "polycast-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Polycast Studio: multi-tenant podcast localization platform on AWS (transcribe, translate, re-voice, lip-sync, QC, package).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up -d && turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "synth": "pnpm --filter @polycast/infra synth",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:services": "docker compose up -d",
    "e2e": "pnpm --filter @polycast/web e2e"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
