{
  "name": "podcast-language-encoder",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless AWS pipeline that transcribes a podcast episode, translates it, and re-voices it in other languages.",
  "bin": {
    "podcast-language-encoder": "bin/podcast-language-encoder.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy PodcastLanguageEncoder --require-approval never",
    "deploy:oidc": "cdk deploy PodcastLanguageEncoderGithubOidc --require-approval never",
    "cdk": "cdk"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1000.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-translate": "^3.700.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0"
  }
}
