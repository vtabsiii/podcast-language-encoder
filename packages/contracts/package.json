{
  "name": "@polycast/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API and event schemas (Zod) for Polycast Studio. `pnpm export-schema` emits JSON Schema consumed by services/media-worker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/export-schema.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polycast/domain": "workspace:*",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
