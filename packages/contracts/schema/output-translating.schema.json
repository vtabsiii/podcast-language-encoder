{
  "$ref": "#/definitions/output-translating",
  "definitions": {
    "output-translating": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "providerVersion": {
          "type": "string"
        },
        "promptVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "translations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "segmentId": {
                "type": "string",
                "format": "uuid"
              },
              "adaptedText": {
                "type": "string"
              },
              "literalText": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "timingBudgetUs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "segmentId",
              "adaptedText",
              "literalText",
              "confidence",
              "timingBudgetUs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "provider",
        "providerVersion",
        "promptVersion",
        "translations"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
