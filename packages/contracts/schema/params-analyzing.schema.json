{
  "$ref": "#/definitions/params-analyzing",
  "definitions": {
    "params-analyzing": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "durationUs": {
              "type": "integer",
              "minimum": 0
            },
            "video": {
              "type": "object",
              "properties": {
                "codec": {
                  "type": "string"
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "frameRate": {
                  "type": "object",
                  "properties": {
                    "num": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "den": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "num",
                    "den"
                  ],
                  "additionalProperties": false
                },
                "variableFrameRate": {
                  "type": "boolean"
                },
                "colorPrimaries": {
                  "type": "string"
                },
                "transferCharacteristics": {
                  "type": "string"
                },
                "hdr": {
                  "type": "boolean"
                }
              },
              "required": [
                "codec",
                "width",
                "height",
                "frameRate",
                "variableFrameRate",
                "hdr"
              ],
              "additionalProperties": false
            },
            "audio": {
              "type": "object",
              "properties": {
                "codec": {
                  "type": "string"
                },
                "sampleRate": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "channels": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "channelLayout": {
                  "type": "string"
                }
              },
              "required": [
                "codec",
                "sampleRate",
                "channels",
                "channelLayout"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "container",
            "durationUs"
          ],
          "additionalProperties": false
        },
        "declaredLocale": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]{2}-[A-Z0-9]{2,3}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assetId",
        "projectId",
        "metadata",
        "declaredLocale"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
