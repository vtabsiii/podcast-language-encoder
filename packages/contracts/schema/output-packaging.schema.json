{
  "$ref": "#/definitions/output-packaging",
  "definitions": {
    "output-packaging": {
      "type": "object",
      "properties": {
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "media",
                  "captions-srt",
                  "captions-vtt",
                  "transcript-json",
                  "qc-report",
                  "provenance-manifest",
                  "checksums"
                ]
              },
              "fileName": {
                "type": "string"
              },
              "contentType": {
                "type": "string"
              },
              "byteSize": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "uri": {
                "type": "string",
                "pattern": "^(s3|local):\\/\\/[a-z0-9.-]+\\/.+$"
              }
            },
            "required": [
              "kind",
              "fileName",
              "contentType",
              "byteSize",
              "sha256",
              "uri"
            ],
            "additionalProperties": false
          }
        },
        "manifest": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "generator": {
              "type": "string"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "jobId": {
              "type": "string",
              "format": "uuid"
            },
            "targetJobId": {
              "type": "string",
              "format": "uuid"
            },
            "projectId": {
              "type": "string",
              "format": "uuid"
            },
            "sourceLocale": {
              "type": "string",
              "pattern": "^[a-z]{2}-[A-Z0-9]{2,3}$"
            },
            "targetLocale": {
              "type": "string",
              "pattern": "^[a-z]{2}-[A-Z0-9]{2,3}$"
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "syntheticVoice": {
              "type": "boolean"
            },
            "lipSyncApplied": {
              "type": "boolean"
            },
            "mock": {
              "type": "boolean"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string",
                    "enum": [
                      "transcription",
                      "translation",
                      "speech",
                      "lipSync",
                      "encode",
                      "quality"
                    ]
                  },
                  "adapterId": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "tier": {
                    "type": "string",
                    "enum": [
                      "production",
                      "beta",
                      "unavailable"
                    ]
                  },
                  "dataPolicy": {
                    "type": "string",
                    "const": "no-training"
                  }
                },
                "required": [
                  "capability",
                  "adapterId",
                  "version",
                  "tier",
                  "dataPolicy"
                ],
                "additionalProperties": false
              }
            },
            "segmentCount": {
              "type": "integer",
              "minimum": 0
            },
            "translationVersionIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fileName": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "byteSize": {
                    "type": "integer"
                  }
                },
                "required": [
                  "fileName",
                  "sha256",
                  "byteSize"
                ],
                "additionalProperties": false
              }
            },
            "disclosure": {
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "generator",
            "generatedAt",
            "jobId",
            "targetJobId",
            "projectId",
            "sourceLocale",
            "targetLocale",
            "sourceSha256",
            "syntheticVoice",
            "lipSyncApplied",
            "mock",
            "models",
            "segmentCount",
            "translationVersionIds",
            "files",
            "disclosure"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "deliverables",
        "manifest"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
