{
  "$ref": "#/definitions/params-validating",
  "definitions": {
    "params-validating": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "quarantine": {
          "type": "string",
          "pattern": "^(s3|local):\\/\\/[a-z0-9.-]+\\/.+$"
        },
        "declaredContentType": {
          "type": "string"
        },
        "declaredByteSize": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "maxDurationUs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "assetId",
        "projectId",
        "quarantine",
        "declaredContentType",
        "declaredByteSize",
        "maxDurationUs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
