{
  "$ref": "#/definitions/qc-report",
  "definitions": {
    "qc-report": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "targetJobId": {
          "type": "string",
          "format": "uuid"
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}-[A-Z0-9]{2,3}$"
        },
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string"
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "provider": {
                "type": "string"
              }
            },
            "required": [
              "metric",
              "threshold",
              "value",
              "passed",
              "provider"
            ],
            "additionalProperties": false
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "segmentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "metric": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ]
              },
              "recommendation": {
                "type": "string"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "open",
                  "accepted",
                  "regenerated",
                  "dismissed"
                ]
              }
            },
            "required": [
              "id",
              "segmentId",
              "metric",
              "severity",
              "recommendation",
              "resolution"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "generatedAt",
        "targetJobId",
        "locale",
        "passed",
        "checks",
        "issues",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
