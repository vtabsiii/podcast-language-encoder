{
  "$ref": "#/definitions/error-envelope",
  "definitions": {
    "error-envelope": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_FAILED",
            "NOT_FOUND",
            "FORBIDDEN",
            "UNAUTHENTICATED",
            "CONFLICT",
            "ILLEGAL_TRANSITION",
            "CONSENT_REQUIRED",
            "CAPABILITY_UNAVAILABLE",
            "BUDGET_EXCEEDED",
            "PROVIDER_UNAVAILABLE",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "message"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "details": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "code",
        "message",
        "correlationId",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
