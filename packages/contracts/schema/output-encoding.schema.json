{
  "$ref": "#/definitions/output-encoding",
  "definitions": {
    "output-encoding": {
      "type": "object",
      "properties": {
        "encode": {
          "type": "string",
          "pattern": "^(s3|local):\\/\\/[a-z0-9.-]+\\/.+$"
        },
        "container": {
          "type": "string"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "encode",
        "container",
        "byteSize"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
