{
  "name": "@polycast/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent domain model for Polycast Studio: entities, job state machine, capability registry, policies, events, and errors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.1",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
