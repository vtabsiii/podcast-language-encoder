{
  "name": "@polycast/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK stacks for Polycast Studio. Also contains the original podcast-language-encoder pipeline stack.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy PodcastLanguageEncoder --require-approval never",
    "deploy:oidc": "cdk deploy PodcastLanguageEncoderGithubOidc --require-approval never",
    "cdk": "cdk",
    "clean": "rm -rf cdk.out dist"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1000.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-translate": "^3.700.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0",
    "source-map-support": "^0.5.21"
  }
}
