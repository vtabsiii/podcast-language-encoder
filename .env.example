# Copy to .env for local development. Never commit .env. No real credentials belong here.
# Every value below is a local/mock default; production fails closed without real ones.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
PUBLIC_API_URL=http://127.0.0.1:4000
AWS_REGION=us-east-1
CORS_ORIGINS=http://localhost:3000

# local = Mock/Local adapters. aws = real providers; required in production.
PROVIDER_MODE=local
ORCHESTRATOR=local

# Postgres (docker compose). The API migrates on boot outside production and creates the
# least-privilege role polycast_app used for every request (row-level security applies to it).
# In AWS the API receives DB_HOST/DB_*_USER/DB_*_PASSWORD parts instead, with DB_SSL=require and
# DB_SSL_ROOT_CERT=/etc/ssl/certs/aws-rds-global-bundle.pem (baked into apps/api/Dockerfile).
DATABASE_URL=postgres://polycast:polycast@localhost:5432/polycast
DATABASE_APP_URL=postgres://polycast_app:polycast_app@localhost:5432/polycast

# Object storage. local = filesystem under LOCAL_STORAGE_DIR with URLs signed by the API.
# s3 = MinIO (docker compose) or AWS S3. The media worker must use the same driver and location.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.polycast-data/storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=polycast
S3_SECRET_ACCESS_KEY=polycastpolycast
MEDIA_BUCKET_QUARANTINE=polycast-quarantine
MEDIA_BUCKET_SOURCE=polycast-source
MEDIA_BUCKET_DERIVED=polycast-derived
MEDIA_BUCKET_DELIVERABLES=polycast-deliverables
SIGNED_URL_TTL_SECONDS=900

# Identity. local = HS256 dev tokens from POST /api/v1/auth/dev-login; cognito = user pool JWKS (M2).
AUTH_MODE=local
LOCAL_JWT_SECRET=polycast-local-dev-secret-not-for-production
COGNITO_USER_POOL_ID=

# Media worker ↔ API shared secret and lease settings.
WORKER_TOKEN=dev-worker-token
TASK_LEASE_SECONDS=300
TASK_MAX_ATTEMPTS=3

# Web
API_BASE_URL=http://127.0.0.1:4000
# The web app reads AUTH_MODE too (server-side, at request time; never NEXT_PUBLIC_):
#   local   = the development sign-in form above (default)
#   cognito = Cognito hosted UI (OAuth 2.0 authorization code + PKCE, public client, no secret).
# In cognito mode these are required as well:
# COGNITO_CLIENT_ID=            user pool app client id (no client secret)
# COGNITO_HOSTED_UI_URL=        e.g. https://polycast-123456789012.auth.us-east-1.amazoncognito.com (no trailing slash)
# WEB_ORIGIN=                   public origin of the web app, e.g. https://d111111abcdef8.cloudfront.net;
#                               builds redirect_uri=${WEB_ORIGIN}/auth/callback and logout_uri=${WEB_ORIGIN}/logout?done=1
#                               (both must be registered on the app client). Falls back to the request origin.

# Worker
POLYCAST_ENV=development
PRIORITY_SCORE_VERSION=2026-Q3
