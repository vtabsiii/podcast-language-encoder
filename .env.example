# Copy to .env for local development. Never commit .env. No real credentials belong here.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
AWS_REGION=us-east-1
CORS_ORIGINS=http://localhost:3000

# local = Mock/Local adapters (docker-compose Postgres + MinIO). aws = real providers; required in production.
PROVIDER_MODE=local
DATABASE_URL=postgres://polycast:polycast@localhost:5432/polycast

# Local S3-compatible storage (MinIO). Production uses private S3 buckets provisioned by infra/.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=polycast
S3_SECRET_ACCESS_KEY=polycastpolycast
MEDIA_BUCKET_SOURCE=polycast-source-local
MEDIA_BUCKET_DELIVERABLES=polycast-deliverables-local

# Identity (Cognito). Empty locally; the local auth adapter issues a fixed dev principal.
COGNITO_USER_POOL_ID=

# Web
API_BASE_URL=http://127.0.0.1:4000

# Worker
POLYCAST_ENV=development
WORKER_QUEUE_URL=
PRIORITY_SCORE_VERSION=2026-Q3
